+            "chosen_pos": chosen_pt,
+            "best_cost": best_cost,
+            "cost_baseline": cost_baseline,
+            "expected_save_s": (cost_baseline - best_cost) if cost_baseline is not None else 0.0,
+            "details": best_details,
+        }
+        return best_r, chosen_pt, info
