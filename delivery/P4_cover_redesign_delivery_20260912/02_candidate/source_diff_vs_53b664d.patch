+        覆盖保证：三角形并集 = 外环 B 的凸包（凸 12/16 边形），
+        只要它包含 Ω = B((0,0),1800)，且每个三角形三边 <= 1000，
+        则对每个 x ∈ Ω，存在包含 x 的三角形 T，其三个顶点都在 x 的 1000m 内，
+        于是 x ∈ conv{静默测站}，证书成立。
+        """
+        P = self.all_points
+
+        def d(a, b):
+            return math.hypot(P[a][0] - P[b][0], P[a][1] - P[b][1])
+
+        max_edge = 0.0
+        area_tri = 0.0
+        for tri in self.triangles:
